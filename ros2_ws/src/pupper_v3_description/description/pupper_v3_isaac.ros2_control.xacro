<?xml version="1.0"?>
<!--
    Isaac Sim variant of pupper_v3_mujoco.ros2_control.xacro.

    Same <xacro:define_components /> as MuJoCo and the real robot, so neural_controller sees
    an identical interface (60 command: position/velocity/effort/kp/kd per joint;
    34 state: 12x position/velocity plus imu_sensor x10) and runs unchanged.

    Requires isaac_bridge.py to be running; see description/isaac_sim/run_isaac_bridge.sh.
    The plugin talks to it over /isaac/joint_command and /isaac/joint_state.

    NOTE for editors: XML comments may not contain a double hyphen. Writing one here makes
    xacro fail with the thoroughly unhelpful "AttributeError: module 'xml' has no attribute
    'parsers'" rather than a parse error.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find pupper_v3_description)/description/components.xacro" />
    <xacro:macro name="pupper_v3_system">
        <ros2_control name="isaac_hardware_interface" type="system">
            <hardware>
                <plugin>isaac_hardware_interface/IsaacHardwareInterface</plugin>

                <!-- Motor model. Identical to the MuJoCo values on purpose: Isaac's PhysX
                     drives are neutralised (stiffness=0, damping=0) and ALL control is
                     torque from this model, so that a MuJoCo vs Isaac diff measures the
                     simulators rather than their actuators. Note the back-EMF limit binds
                     at ~1.37 Nm at zero velocity, i.e. below software_torque_limit. -->
                <param name="bus_voltage">24.0</param>
                <param name="kt">0.04</param>
                <param name="phase_resistance">0.7</param>
                <param name="saturation_torque">4.5</param>
                <param name="software_torque_limit">3.0</param>

                <!-- Where that model runs. Must match isaac_bridge.py's torque mode:
                       torque_source=isaac   with  run_isaac_bridge.sh (default: model)
                       torque_source=plugin  with  run_isaac_bridge.sh passthrough
                     "isaac" mirrors MuJoCo, which runs update_ctrl_() before every mj_step,
                     i.e. on fresh state at the physics rate. "plugin" runs the same C++
                     header here instead: zero drift from MuJoCo's code, but the PD then
                     closes at the controller rate on DDS-stale feedback. -->
                <param name="torque_source">isaac</param>

                <!-- <param name="use_imu">false</param> -->

                <!-- Match MuJoCo's active 8/10 (pupper_v3_mujoco.ros2_control.xacro:19-20).
                     These count CONTROL CYCLES, not physics timesteps (enqueue() runs once per
                     read()/write()). At the controller_manager update_rate of 520 Hz that is
                     15.4 ms command / 19.2 ms imu of artificial latency, modelling the real
                     robot's sense/actuate delay against a zero-transport in-process sim.
                     Isaac adds REAL DDS transport on top, so in principle these should be
                     reduced by the round trip to keep the totals equal. But the transport was
                     measured at 0.233 ms one-way mean (0.12 of a 1.923 ms cycle; p99 0.95 ms),
                     i.e. sub-cycle. 8 minus 0.12 and 10 minus 0.12 both round back to 8/10, and any
                     residual is far below the noise floor set by the 250 Hz-vs-10 kHz physics
                     gap. So 8/10 it is. Re-measure (distrobox-setup/lat_ping.py) if the
                     transport or rate changes materially. -->
                <param name="imu_latency_timesteps">10</param>
                <param name="command_latency_timesteps">8</param>
            </hardware>
            <xacro:define_components />
        </ros2_control>
    </xacro:macro>
</robot>
